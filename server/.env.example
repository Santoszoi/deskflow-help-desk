PORT=3333
JWT_SECRET=
DB_CLIENT=sqlite
DEMO_SEED=true
# Set DB_CLIENT=mysql and supply these values for MySQL:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=deskflow
DB_PASSWORD=
DB_NAME=deskflow
# Enable verified TLS for a hosted MySQL database. Never disable certificate verification.
DB_SSL=false
# With DB_SSL=true, optionally supply the provider CA using one of these:
# DB_SSL_CA_PATH=/etc/secrets/mysql-ca.pem
# DB_SSL_CA=multiline PEM certificate
